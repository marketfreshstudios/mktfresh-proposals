{
  "name": "mktfresh-proposals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "import": "node --env-file-if-exists=.env.local --import tsx scripts/proposify-import/index.ts",
    "verify:supabase": "tsx scripts/verify-supabase.ts",
    "format:check": "prettier --check src scripts tests e2e *.ts *.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "csv-parse": "7.0.2",
    "next": "16.3.5",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.8",
    "supabase": "2.117.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
