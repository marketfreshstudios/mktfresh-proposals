# Explicit local mode: file-backed development repository; mock external providers.
APP_MODE=local
DATA_DIR=.data
# Canonical client/email/Checkout origin. HTTPS required in deployment.
APP_URL=http://127.0.0.1:3000
# Local test bearer; never accepted with NODE_ENV=production or VERCEL set.
DEV_STAFF_TOKEN=replace-with-a-long-random-local-token
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Owner-run purge maintenance only; database-owner URL for this same project. Never NEXT_PUBLIC_.
SUPABASE_DB_URL=
STORAGE_BUCKET=proposal-files
CRON_SECRET=
RESEND_API_KEY=
# Missing providers stay mocked only in local/test mode. Supabase mode records needs_review.
# Workspace 1 continues to bill directly with this key.
STRIPE_SECRET_KEY=
# Stripe Connect Standard OAuth for other workspaces (sandbox only).
STRIPE_CONNECT_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
# Defaults to APP_URL + /api/connections/stripe/callback.
STRIPE_CONNECT_REDIRECT_URI=
STRIPE_CONNECT_WEBHOOK_SECRET=
QBO_REALM_ID=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_ENVIRONMENT=sandbox
# Optional fixed callback override per environment. Defaults to APP_URL + /api/connections/qbo/callback.
QBO_REDIRECT_URI=
# Optional local browser override. Vercel uses the bundled serverless Chromium.
CHROMIUM_EXECUTABLE_PATH=
# Proposify export automation uses a dedicated profile, never your normal Chrome profile.
PROPOSIFY_PROFILE=.data/proposify-profile
PROPOSIFY_BASE_URL=
# Test mode only. Runtime refuses any Stripe key without sk_test_ or rk_test_.
STRIPE_WEBHOOK_SECRET=
# Leave mock until owner supplies test credentials. Only test or mock supported here.
BILLING_MODE=mock
# Generate 32 random bytes encoded as base64; encrypts per-workspace OAuth tokens and linked-reference Basic auth credentials.
INTEGRATION_ENCRYPTION_KEY=
# Canonical HTTPS app origin in deployment; loopback is accepted for local tests.
OAUTH_ISSUER=http://127.0.0.1:3000
# Optional additional exact connector callback URIs, comma-separated; no wildcards.
OAUTH_REDIRECT_URIS=

# Optional public build identity for self-hosted deployments. Vercel supplies its identity automatically.
# YESWELL_BUILD_ID=release-unique-id
