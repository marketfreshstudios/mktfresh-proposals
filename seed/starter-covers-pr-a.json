{
  "general-project": {
    "logo_mode": "brand",
    "workspace": "{{workspace.name}}",
    "eyebrow": "Project proposal",
    "byline": "{{proposal.validity}}",
    "elements": [
      {
        "id": "logo",
        "kind": "logo",
        "align": "left"
      },
      {
        "id": "eyebrow",
        "kind": "eyebrow",
        "align": "left",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Project proposal"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "title",
        "kind": "title",
        "align": "left",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "variable",
                  "attrs": {
                    "path": "proposal.title"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": "prepared_for",
        "kind": "prepared_for",
        "align": "left",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Prepared for "
                },
                {
                  "type": "variable",
                  "attrs": {
                    "path": "client.full_name"
                  }
                },
                {
                  "type": "text",
                  "text": ", "
                },
                {
                  "type": "variable",
                  "attrs": {
                    "path": "client.company"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": "byline",
        "kind": "byline",
        "align": "left",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Prepared by "
                },
                {
                  "type": "variable",
                  "attrs": {
                    "path": "sender.name"
                  }
                },
                {
                  "type": "text",
                  "text": ", "
                },
                {
                  "type": "variable",
                  "attrs": {
                    "path": "workspace.name"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": "date",
        "kind": "extra",
        "align": "left",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "variable",
                  "attrs": {
                    "path": "proposal.date"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "id": "validity",
        "kind": "extra",
        "align": "left",
        "content": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "variable",
                  "attrs": {
                    "path": "proposal.validity"
                  }
                }
              ]
            }
          ]
        }
      }
    ]
  },
