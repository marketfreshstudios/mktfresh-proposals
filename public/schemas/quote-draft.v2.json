{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "source": {
      "type": "string",
      "const": "playbook"
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "client": {
      "type": "object",
      "properties": {
        "company": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "first_name": {
          "type": "string",
          "maxLength": 100
        },
        "last_name": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        }
      },
      "required": [
        "company",
        "first_name",
        "last_name",
        "email"
      ],
      "additionalProperties": false
    },
    "items": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 10000
          },
          "source": {
            "type": "string",
            "enum": [
              "catalog",
              "custom"
            ]
          },
          "pricing_item_id": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "custom_family_id": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sublines": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "label": {
                  "type": "string",
                  "maxLength": 200
                },
                "amount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000000
                },
                "list_amount": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "interval": {
                  "type": "string",
                  "enum": [
                    "one_time",
                    "month",
                    "year"
                  ]
                },
                "qty": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "stripe_lookup_key": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "qbo_item_ref": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "amount",
                "list_amount",
                "interval",
                "qty",
                "stripe_lookup_key",
                "qbo_item_ref"
              ],
              "additionalProperties": false
            }
          },
          "optional": {
            "type": "boolean"
          },
          "default_selected": {
            "type": "boolean"
          },
          "selected": {
            "type": "boolean"
          },
          "choice_group_id": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "min_term_months": {
            "default": null,
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "schedule": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "after_paid_invoices": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "then": {
                    "type": "object",
                    "properties": {
                      "amount": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100000000
                      },
                      "lookup_key": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "amount",
                      "lookup_key"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "after_paid_invoices",
                  "then"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "plan_terms": {
            "default": null,
            "anyOf": [
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "ai_entered": {
            "type": "boolean"
          },
          "price_review": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "keep",
                "list"
              ]
            }
          }
        },
        "required": [
          "id",
          "order",
          "name",
          "description",
          "source",
          "pricing_item_id",
          "custom_family_id",
          "sublines",
          "optional",
          "default_selected",
          "choice_group_id",
          "min_term_months",
          "schedule",
          "plan_terms"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 50000
    }
  },
  "required": [
    "source",
    "source_version",
    "items"
  ],
  "additionalProperties": false
}
